    {
      "parameters": {
        "jsCode": "const binaryData = items[0].binary.data;\nconst base64Image = binaryData.data;\nconst mimeType = binaryData.mimeType || 'image/jpeg';\n\nreturn [{\n  json: {\n    base64Image,\n    mimeType\n  }\n}];"
      },
      "id": "node-prepare-gemini-payload",
      "name": "Siapkan Payload Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "ISI_GEMINI_API_KEY_ANDA"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Kamu adalah asisten keuangan pribadi. Analisis gambar struk belanja, nota, atau bukti transfer berikut. Kembalikan HANYA JSON MURNI tanpa markdown (tanpa ```json) dengan format:\\n{\\n  \\\"type\\\": \\\"expense\\\" atau \\\"income\\\",\\n  \\\"amount\\\": 50000,\\n  \\\"wallet_name\\\": \\\"BCA\\\" atau \\\"Dana\\\" atau \\\"Jago\\\" atau \\\"Dompet\\\" (sesuai logo/nama bank/e-wallet jika terbaca, kosongkan jika tidak ada),\\n  \\\"category_or_source\\\": \\\"Makan/jajan\\\" atau \\\"Belanja\\\" atau \\\"Transport\\\" atau \\\"Kebutuhan\\\",\\n  \\\"notes\\\": \\\"Nama toko atau keterangan singkat\\\",\\n  \\\"date\\\": \\\"YYYY-MM-DD\\\"\\n}\\nJika tidak yakin dompetnya, kosongkan wallet_name. Nominal harus angka murni tanpa titik/koma/Rp.\"\n        },\n        {\n          \"inlineData\": {\n            \"mimeType\": \"{{ $json.mimeType }}\",\n            \"data\": \"{{ $json.base64Image }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "node-gemini-ocr",
      "name": "Gemini AI Vision OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1580,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseText = items[0].json.candidates[0].content.parts[0].text;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(responseText.trim().replace(/^```json/, '').replace(/```$/, ''));\n} catch (e) {\n  parsed = {\n    type: 'expense',\n    amount: 0,\n    notes: 'Gagal mengekstrak data struk',\n    category_or_source: 'Kebutuhan'\n  };\n}\n\nreturn [{\n  json: {\n    p_chat_id: '2037807600',\n    p_type: parsed.type || 'expense',\n    p_amount: Math.round(Number(parsed.amount) || 0),\n    p_wallet_name: parsed.wallet_name || null,\n    p_category_or_source: parsed.category_or_source || null,\n    p_notes: parsed.notes || 'Dari Foto Struk',\n    p_date: parsed.date || null\n  }\n}];"
      },
      "id": "node-parse-gemini-json",
      "name": "Parse JSON Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
