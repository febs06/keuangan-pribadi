              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_chat_id\": \"{{ $json.p_chat_id }}\",\n  \"p_type\": \"{{ $json.p_type }}\",\n  \"p_amount\": {{ $json.p_amount }},\n  \"p_wallet_name\": {{ $json.p_wallet_name ? '\"' + $json.p_wallet_name + '\"' : 'null' }},\n  \"p_category_or_source\": {{ $json.p_category_or_source ? '\"' + $json.p_category_or_source + '\"' : 'null' }},\n  \"p_notes\": {{ $json.p_notes ? '\"' + $json.p_notes + '\"' : 'null' }},\n  \"p_date\": {{ $json.p_date ? '\"' + $json.p_date + '\"' : 'null' }}\n}",
        "options": {}
